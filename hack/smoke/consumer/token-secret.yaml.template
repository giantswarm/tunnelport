# Template for the registration-secret Secret in the consumer cluster.
# The runbook materialises this with:
#
#   kubectl -n smoke create secret generic smoke-bot-token \
#     --from-literal=token=$(cat /tmp/smoke-bot-registration-secret)
#
# This file is the literal-YAML alternative for users who'd rather
# `kubectl apply -f` than `kubectl create secret`. Replace the
# placeholder, base64-encode the value, and apply.
#
# Per ADR 0005 the operator now joins via `bound_keypair`. The Secret
# value is the **registration secret** retrieved from Teleport (see
# the runbook's §4 — `tctl get token/smoke-bot-token --format=json |
# jq -r '.[0].status.bound_keypair.registration_secret'`), NOT a
# multi-use static token. With `recovery.mode: relaxed` on the Central-
# side token resource, the secret remains usable for re-registration
# indefinitely — treat it as a long-lived credential and deliver it
# out-of-band via your team's chosen pattern (sealed-secrets,
# external-secrets-operator, etc.). The operator never reads
# `Secret.Data` — it only references the Secret by name in the tbot
# pod's volume mount.
apiVersion: v1
kind: Secret
metadata:
  name: smoke-bot-token
  namespace: smoke
type: Opaque
stringData:
  # The registration secret retrieved from
  #   tctl get token/smoke-bot-token --format=json
  # under .status.bound_keypair.registration_secret. Must match the
  # value in step 4 of hack/smoke/README.md.
  token: REPLACE_WITH_SMOKE_BOT_REGISTRATION_SECRET
