# Template for the token Secret in the consumer cluster. The runbook
# materialises this with:
#
#   kubectl -n smoke create secret generic smoke-bot-token \
#     --from-literal=token=$(cat /tmp/smoke-bot-token)
#
# This file is the literal-YAML alternative for users who'd rather
# `kubectl apply -f` than `kubectl create secret`. Replace the
# placeholder, base64-encode the token, and apply.
#
# In production, deliver this Secret out-of-band (sealed-secrets,
# external-secrets-operator, or your team's chosen pattern). The
# operator never reads `Secret.Data` — it only references the Secret
# by name in the tbot pod's volume mount.
apiVersion: v1
kind: Secret
metadata:
  name: smoke-bot-token
  namespace: smoke
type: Opaque
stringData:
  # The literal token string from `tctl tokens add --type=bot
  # --bot-name=smoke-bot` on the Teleport control plane. Must match
  # the `token` value in hack/smoke/teleport/tokens.yaml's
  # smoke-bot-token entry.
  token: REPLACE_WITH_SMOKE_BOT_TOKEN
