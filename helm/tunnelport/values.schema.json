{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "affinity": {
            "type": "object",
            "additionalProperties": false
        },
        "crds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "install": {
                    "type": "boolean"
                }
            }
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as the `additionalProperties` setting would otherwise collide with Helm's special 'global' values key."
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "pullPolicy": {
                    "type": "string"
                },
                "registry": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "imagePullSecret": {
            "type": "string"
        },
        "installNamespace": {
            "type": "string"
        },
        "monitoring": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "prometheusRule": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        }
                    }
                }
            }
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "nodeSelector": {
            "type": "object",
            "additionalProperties": false
        },
        "podDisruptionBudget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "minAvailable": {
                    "type": "integer"
                },
                "unhealthyPodEvictionPolicy": {
                    "type": "string"
                }
            }
        },
        "podSecurityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "fsGroup": {
                    "type": "integer"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "ports": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "health": {
                    "type": "integer"
                },
                "metrics": {
                    "type": "integer"
                }
            }
        },
        "replicaCount": {
            "type": "integer"
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "tbot": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "image": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "digest": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "registry": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "insecure": {
                    "type": "boolean"
                },
                "resources": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "teleport": {
            "type": "object",
            "additionalProperties": false
        },
        "tls": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "image": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "digest": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "registry": {
                            "type": "string"
                        },
                        "tag": {
                            "type": "string"
                        }
                    }
                },
                "port": {
                    "type": "integer"
                },
                "reloadInterval": {
                    "type": "string"
                }
            }
        },
        "tolerations": {
            "type": "array"
        },
        "trustBundle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "credentialTTL": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "renewalInterval": {
                    "type": "string"
                },
                "resources": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "secretName": {
                    "type": "string"
                },
                "tokenName": {
                    "type": "string"
                },
                "workloadIdentityLabels": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "trust-bundle": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    }
}
